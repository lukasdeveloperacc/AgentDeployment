# Staging Environment Variables
# 스테이징 환경 (프로덕션 배포 전 테스트)

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone Vector DB
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=rag-demo-stage

# Environment
ENVIRONMENT=staging
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# CORS Settings
CORS_ORIGINS=http://staging.yourdomain.com
