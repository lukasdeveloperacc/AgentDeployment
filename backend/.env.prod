# Production Environment Variables
# 프로덕션 환경에서는 AWS Secrets Manager 또는 환경변수로 주입

# OpenAI API
OPENAI_API_KEY=${OPENAI_API_KEY}

# Pinecone Vector DB
PINECONE_API_KEY=${PINECONE_API_KEY}
PINECONE_INDEX_NAME=rag-demo-prod

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# CORS Settings (프로덕션에서는 엄격하게)
CORS_ORIGINS=https://yourdomain.com
